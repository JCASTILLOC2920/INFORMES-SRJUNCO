// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Report {
  id              String   @id @default(cuid())
  attentionCode   String   @unique
  patientDni      String
  patientFirstName String
  patientLastName  String
  age             Int?
  phone           String?
  gender          String?
  serviceType     String?
  solicitor       String?
  sampleType      String?
  receptionDate   DateTime?
  reportDate      DateTime?
  macroscopy      String?
  microscopy      String?
  diagnosis       String?
  cost            Float?   @default(0)
  transportCost   Float?   @default(0)
  isPendingPayment Boolean @default(false)
  prepayment      Float?   @default(0)
  balance         Float?   @default(0)
  contactName     String?
  contactPhone    String?
  studyMotive     String?
  clinic          String?
  expectedDeliveryDate DateTime?
  hasImages       Boolean  @default(false)
  imageUrls       String[] @default([])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([attentionCode])
  @@index([patientDni])
  @@index([receptionDate])
}

model Doctor {
  id              String   @id @default(cuid())
  type            String?  // TIPO
  province        String?  // PROVINCIA
  name            String   // DOCTOR (Nombre completo)
  specialization  String?  // # ESPECIALIZACIÓN
  licenseNumber   String?  // # COLEGIADO
  phone           String?  // # TELEFONO
  email           String?  // CORREO
  signatureUrl    String?  // FIRMA
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([name])
}
